    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_offline_title">Runs on your device</string>
    <string name="about_offline_body">Conversion runs on your device. Files are not uploaded, and there is no account or tracking. The only network request is the optional OCR pack download.</string>
    <string name="about_privacy_title">Your files stay yours</string>
    <string name="about_privacy_body">Sigha asks only for the files you pick. Internet is used only when you download an optional model pack.</string>
    <string name="about_oss_title">Built on open source</string>
